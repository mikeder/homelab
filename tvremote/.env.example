# Copy to tvremote/.env on the server. Give each TV a DHCP reservation so its IP stays put.
# The stack won't start until all six are set.
#
# The MACs are needed to turn the TVs on (Wake-on-LAN). On each TV, also turn on
# Settings > General > Network > Expert Settings > Power On with Mobile.
TV1_IP=192.168.1.x
TV1_MAC=AA:BB:CC:DD:EE:FF

TV2_IP=192.168.1.x
TV2_MAC=AA:BB:CC:DD:EE:FF

TV3_IP=192.168.1.x
TV3_MAC=AA:BB:CC:DD:EE:FF
