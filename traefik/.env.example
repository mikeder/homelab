# Route53 access for Let's Encrypt's DNS challenge. Keys for the IAM user that has only
# traefik/iam-acme-policy.json attached. See traefik/README.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Hosted zone ID of sqweeb.net (Route53 console, or:
# aws route53 list-hosted-zones-by-name --dns-name sqweeb.net)
AWS_HOSTED_ZONE_ID=
